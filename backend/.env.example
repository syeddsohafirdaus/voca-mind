# Voca Mind Backend Environment Configuration Example
# Copy this file to .env for local development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voca_mind
ENVIRONMENT=development
LOG_LEVEL=INFO

# Firebase Authentication Configuration (Placeholders Only - Never Commit Secrets)
FIREBASE_PROJECT_ID=voca-mind-dev
FIREBASE_CREDENTIALS_PATH=
FIREBASE_AUTH_EMULATOR_HOST=

# Qdrant Vector Store & Embedding Configuration (Placeholders Only - Never Commit Secrets)
# For local Qdrant, API key is omitted. For hosted Qdrant Cloud, specify URL and API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=voca_mind_knowledge
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

